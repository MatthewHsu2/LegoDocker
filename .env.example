# Root-level shared variables. Copy to `.env` and fill in.
# Only cross-cutting values belong here — per-lego secrets live in each lego's own .env.

# Public base domain.
DOMAIN=soletreadmills.com

# Timezone applied to containers.
TZ=America/Denver

# LAN mode only (compose.lan.yaml). The host's fixed LAN IP or hostname, used to build the
# links Metabase puts in emails and alerts. Reserve the address on the router first — a DHCP
# lease change silently breaks every link already sent.
LAN_HOST=192.168.1.50

# Funnel mode only (compose.funnel.yaml). The public HTTPS address Tailscale Funnel serves.
# Read it from `tailscale funnel status`. This overrides LAN_HOST for MB_SITE_URL, because
# outside viewers cannot resolve a private address.
PUBLIC_URL=https://your-host.your-tailnet.ts.net
