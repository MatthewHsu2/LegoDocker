# Metabase lego secrets. Copy to `.env` in this folder and fill in, then `chmod 600 .env`.

# --- Metabase metadata Postgres (self-hosted) ---
# NOTE: Docker Compose interpolates `$` in .env values, so a literal `$` in the password must
# be written as `$$` here (or just generate a password without `$`). Other symbols are fine.
MB_DB_DBNAME=metabaseappdb
MB_DB_USER=metabase
MB_DB_PASS=change-me-strong-password

# --- Encryption key for data-source credentials at rest ---
# Encrypts connected-database credentials (e.g. the SpiritWebDB login) inside the app DB.
# Without it, those credentials — and the nightly pg_dump shipped to Azure — are PLAINTEXT.
# Generate ONCE and keep it forever:  openssl rand -base64 32
# WARNING: losing or changing this key is unrecoverable (you'd have to re-enter every data
# source). Store it somewhere OTHER than the DB backups — a restore needs the dump AND this key.
# It has no Docker-secret (_FILE) variant, so it must live here in .env.
MB_ENCRYPTION_SECRET_KEY=change-me-run-openssl-rand-base64-32

# --- JVM heap / container memory ---
# The JVM otherwise grabs ~1/4 of the whole VM's RAM, ignoring Postgres + the rest of the stack.
# Rule of thumb (Metabase docs): leave 1-2 GB for other processes — e.g. 2g heap on a 4 GB VM,
# ~2 GB + 1 CPU per 20 concurrent users. Keep MB_MEM_LIMIT roughly 1g above MB_JAVA_XMX.
MB_JAVA_XMX=2g
MB_MEM_LIMIT=3g

# --- Nightly backup ---
# SAS URL for the Azure Blob *container* that receives the dumps, e.g.
#   https://<account>.blob.core.windows.net/<container>?<sas-token>
# The SAS token needs Write + Create (and List) permissions on that container.
AZURE_BLOB_SAS_URL=https://youraccount.blob.core.windows.net/metabase-backups?sv=...&sig=...

# Keep this many days of local dumps (uploaded copies live in Azure by retention policy).
RETENTION_DAYS=14

# Cron schedule (in ${TZ}) for the nightly dump. Default 02:00 daily.
BACKUP_CRON=0 2 * * *
