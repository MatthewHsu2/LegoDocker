# Copy to .env and fill in. The host copy lives at /home/it/legodocker-secrets/dicks-sync.env.

# SPS Commerce portal: the shared login.
SPS_EMAIL=nick@soletreadmills.com
SPS_PASSWORD=

# Spirit Web DB. dicks_sync is a contained user with rights on schema ext only (sql/setup.sql).
SQL_SERVER=spiritserver.database.windows.net
SQL_DATABASE=spiritwebdb
SQL_USER=dicks_sync
SQL_PASSWORD=

# Data posts Sunday ~8 PM Mountain; a daily run retries a failed Monday on its own.
SYNC_CRON=0 6 * * *
DICKS_SYNC_TZ=America/Denver
